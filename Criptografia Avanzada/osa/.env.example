# Copiá este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completá valores propios antes de levantar el stack. docker-compose lee
# ".env" automáticamente — no hace falta pasarlo con --env-file.
#
# NINGUNO de estos valores tiene un default hardcodeado en el servidor
# (internal/config/config.go es fail-closed a propósito): si falta alguno
# obligatorio, el contenedor "api" no arranca.

# --- Postgres ---
POSTGRES_USER=osa_app
POSTGRES_PASSWORD=cambiar-esta-contraseña
POSTGRES_DB=osa_dev

# --- Secretos del servidor (OBLIGATORIOS, sin default) ---
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SIGNING_KEY=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# EXACTAMENTE 32 bytes (no 32 caracteres en cualquier codificación — 32
# bytes crudos). Generar con: openssl rand -hex 16   (produce 32 caracteres
# hex = 16 bytes... usar en cambio algo como el siguiente comando, que sí da
# 32 bytes exactos si se usan sólo caracteres ASCII de 1 byte):
#   openssl rand -base64 24 | cut -c1-32
TOTP_ENCRYPTION_KEY=01234567890123456789012345678901

# --- Entorno ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
AUDIT_IP_TRUNCATE=true
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Puertos publicados en el host ---
API_PORT=8080
CLIENT_PORT=5173

# URL que el NAVEGADOR usa para hablarle a la API — normalmente
# http://localhost:<API_PORT>, no un hostname interno de Docker.
VITE_API_BASE_URL=http://localhost:8080
