DATABASE_URL=postgres://osa_app:devpassword@127.0.0.1:5432/osa_dev?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
JWT_SIGNING_KEY=dev-only-signing-key-change-me-32chars-min
TOTP_ENCRYPTION_KEY=01234567890123456789012345678901
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
AUDIT_IP_TRUNCATE=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
# MIGRATIONS_DIR: sin setear, el binario usa "migrations" relativo al cwd
# (correcto si corrés `go run ./cmd/api` desde este directorio). Descomentar
# sólo si necesitás apuntar a otra ruta absoluta.
#MIGRATIONS_DIR=/ruta/absoluta/a/osa/server/migrations
